# Copy to .env and adjust for the local machine.
# All values below are test-only defaults.

PG_PORT=15432
PG_USER=pudding
PG_PASSWORD=pudding
PG_DB=source_db
PG_TARGET_DB=target_db

MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=pudding
MYSQL_USER=pudding
MYSQL_PASSWORD=pudding
MYSQL_DB=source_db
MYSQL_TARGET_DB=target_db

MONGO_PORT=27018

KAFKA_PORT=19092
SCHEMA_REGISTRY_PORT=18081

ES_PORT=19200
# Keep the value quoted: scripts source this file in bash.
# ES_JAVA_OPTS="-Xms2g -Xmx2g"

MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=pudding
MINIO_ROOT_PASSWORD=pudding-secret
# Optional image overrides. The server image must expose the MinIO S3 API and
# /minio/health/live; the client image must provide `mc` for minio-init.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2023-09-04T19-57-37Z
# MINIO_CLIENT_IMAGE=minio/mc:RELEASE.2023-09-04T19-57-37Z

REDIS_PORT=16379
ETCD_PORT=12379

HDFS_NAMENODE_PORT=18020
HDFS_NAMENODE_UI_PORT=19870
HDFS_DATANODE_PORT=19866
